# EXPO_PUBLIC_* queda embebido en el bundle de JS en tiempo de build -- no
# es secreto (es la URL pública del backend, no una API key), por eso este
# archivo SÍ se commitea (a diferencia de .env.local). Sin esto, la app
# (app_movil/src/api/client.ts) no tiene ningún backend contra el cual
# pegarle -- encontrado al probar el development build por primera vez en
# un emulador real: el login cargaba la pantalla pero cualquier request
# fallaba porque API_BASE_URL quedaba "".
EXPO_PUBLIC_API_URL=https://securapp.devquad.cl

# DSN del proyecto de Sentry (sentry.io) -- de solo-ingesta, no es
# secreto, por eso va en este .env (ver src/monitoreo/sentry.ts). Vacío
# por ahora: todavía no hay cuenta de Sentry creada. Sin esto, Sentry
# queda sin inicializar (no rompe nada, simplemente no reporta errores).
EXPO_PUBLIC_SENTRY_DSN=https://afbcef69d8195fd9f235c606139927f5@o4512322680520704.ingest.us.sentry.io/4512322704572416
